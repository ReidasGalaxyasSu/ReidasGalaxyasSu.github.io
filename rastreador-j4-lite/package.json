{
  "name": "rastreador-j4-lite",
  "private": true,
  "version": "1.0.0",
  "description": "RealTracker J4 Lite em 3D: desenho técnico que vira o equipamento, desmontagem e remontagem guiadas pelo scroll",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=app.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=app.js --watch",
    "export": "node scripts/export-model.mjs",
    "video": "node scripts/render-video.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.160.0",
    "three-bvh-csg": "0.0.16",
    "three-mesh-bvh": "0.7.3"
  }
}
